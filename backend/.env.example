# Copy this file to .env and fill in real values. Never commit .env.

# Server Configuration
PORT=5000
# URL the frontend is served from (used for CORS)
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Neon: postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# Local: postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME

# JWT Configuration (use a long random string)
JWT_SECRET=replace-with-a-long-random-string
